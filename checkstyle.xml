<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Checkstyle configuration for MTG project.
    Enforces no fully qualified names (FQN) outside of imports.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <!-- Disallow fully qualified names in code (must use imports) -->
        <module name="AvoidStarImport">
            <property name="severity" value="warning"/>
        </module>

        <!-- Enforce import usage - no inline fully qualified class names -->
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun"/>
        </module>

        <!-- Redundant imports -->
        <module name="RedundantImport"/>

        <!-- Unused imports -->
        <module name="UnusedImports"/>

        <!--
            Custom check: No fully qualified names in code.
            This regex matches patterns like "com.example.Class" or "java.util.List"
            that appear outside of import statements.
        -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="NoFQNInCode"/>
            <property name="format" value="^\s*(?!import\s|package\s|module\s|\*|//|/\*|\s*\*).*\b([a-z][a-z0-9]*\.){2,}[A-Z][a-zA-Z0-9]*\b"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Avoid fully qualified names in code. Use imports instead."/>
        </module>
    </module>

    <!-- Exclude module-info.java completely (checkstyle doesn't support Java 25 module imports yet) -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value="module-info\.java$"/>
    </module>

    <!-- Suppress checks for module-info.java which legitimately uses module names -->
    <module name="SuppressionSingleFilter">
        <property name="files" value="module-info\.java"/>
        <property name="checks" value="RegexpSinglelineJava"/>
        <property name="id" value="NoFQNInCode"/>
    </module>

    <!-- Suppress for package-info.java which needs FQN in annotations before imports -->
    <module name="SuppressionSingleFilter">
        <property name="files" value="package-info\.java"/>
        <property name="checks" value="RegexpSinglelineJava"/>
        <property name="id" value="NoFQNInCode"/>
    </module>
</module>
